#!/bin/bash
# Run Odysseus, the self-hosted AI workspace, with Docker Compose.
#
# Usage: odysseus up|down|status|logs|update|open
#
#   up      start it (the first run pulls the images and prints the admin
#           password); it then starts with Docker on every boot
#   down    stop it until the next odysseus up
#   status  show its containers
#   logs    follow its logs
#   update  pull the newest main branch and images, and restart it
#   open    open http://localhost:7011 in the browser
#
# It lives in ~/.local/share/odysseus; its settings are in the .env there.

set -euo pipefail

dir=$HOME/.local/share/odysseus
url=http://localhost:7011
[[ -d $dir ]] || { echo "odysseus: $dir is missing; clone it with: git clone -b main https://github.com/odysseus-dev/odysseus.git $dir" >&2; exit 1; }
cd "$dir"

# Ollama on this machine is reached from the container over docker0, which
# ufw blocks like any other incoming connection.
allow_ollama() {
    if [[ -d /etc/runit/sv/ollama ]] && command -v ufw >/dev/null; then
        sudo ufw status | grep -q '11434/tcp on docker0' ||
            sudo ufw allow in on docker0 to any port 11434 proto tcp comment 'Odysseus to Ollama'
    fi
}

case ${1:-} in
    up)
        allow_ollama
        docker compose up -d
        echo "Odysseus is starting at $url"
        if [[ ! -e .artixy-first-up ]]; then
            echo "Waiting for the first admin password (Ctrl-C to skip)..."
            for _ in $(seq 60); do
                if docker compose logs odysseus 2>/dev/null | grep -i 'password'; then
                    touch .artixy-first-up
                    break
                fi
                sleep 5
            done
        fi
        ;;
    down) docker compose down ;;
    status) docker compose ps ;;
    logs) docker compose logs -f ;;
    update)
        git pull --ff-only
        docker compose pull
        docker compose up -d
        ;;
    open) xdg-open "$url" ;;
    *) sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0"; exit 2 ;;
esac
